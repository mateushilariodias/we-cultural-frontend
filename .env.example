# URL do backend (Node.js/Express)
# Desenvolvimento: http://localhost:3001
# Produção: https://we-cultural-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública do frontend (usada para geração do sitemap)
# Desenvolvimento: http://localhost:3000
# Produção: https://www.noscultura.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — Measurement ID (ex: G-XXXXXXXXXX)
# Deixe em branco para desativar o rastreamento (ex: em desenvolvimento)
NEXT_PUBLIC_GA_ID=
